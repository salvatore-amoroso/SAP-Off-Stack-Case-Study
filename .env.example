# Node 24 reads this format directly; no MCP tooling or dotenv package is needed.
# Copy to .env (ignored by Git), or set these four process environment variables.
# SAP_ENV_PATH may select another private file. Environment values override it.
SAP_URL=https://127.0.0.1
SAP_CLIENT=001
SAP_USERNAME=
SAP_PASSWORD=
# Absolute directory containing the separately licensed Linux ABAP ODBC libraries
# and public sap-trial-ca.pem certificate. Optional legacy sibling path is retained.
ABAP_ODBC_DRIVER_DIR=
